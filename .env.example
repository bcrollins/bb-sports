# BB Sports — environment variables
# Copy to .env.local for local development. Production values go in Railway → Variables.

# Public site URL (used for canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL="https://bbsports.fans"

# Site-wide access wall (public visitors see a blank white wall until this is entered)
GATE_PASSWORD="calebwilliamsMVP"

# Stripe (donations) — leave unset until ready to accept donations
STRIPE_DONATION_LINK=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (email) — for newsletter welcome + transactional in v1.1
RESEND_API_KEY=""
RESEND_FROM="brad@mail.bbsports.fans"

# xAI Grok (AI drafting / counterpoint) — wired up in v1.1
XAI_API_KEY=""
BBSPORTS_APPROVED_XAI="false"
XAI_IMAGE_MODEL="grok-imagine-image"
XAI_VIDEO_MODEL="grok-imagine-video"

# Database (Neon / Railway Postgres) — wired up in v1.1
DATABASE_URL=""

# Auth (NextAuth or magic-link) — wired up in v1.1
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudflare R2 (object storage for images / podcast / video) — v1.1
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Approved provider gates (BB Sports Perfection Engine — Component 22)
BBSPORTS_APPROVED_LIVE_SCORES_FEED="false"
BBSPORTS_APPROVED_X_API="false"
BBSPORTS_APPROVED_YOUTUBE_TRANSCRIPT="false"
