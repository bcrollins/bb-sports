# BB Sports — environment variables
# Copy to .env.local for local development. Production values go in Railway → Variables.

# Public site URL (used for canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL="https://bbsports.fans"

# Site-wide access wall. Keep both values in Railway only; never commit a live password.
# GATE_PASSWORD is also the operator recovery credential when an admin-managed wall password exists.
# Generate GATE_COOKIE_SECRET with: openssl rand -hex 32
GATE_PASSWORD=""
GATE_COOKIE_SECRET=""

# Stripe (donations) — leave unset until ready to accept donations.
# STRIPE_SECRET_KEY enables BB Sports-created Checkout Sessions.
# STRIPE_WEBHOOK_SECRET enables signed webhook reconciliation at /api/stripe/webhook.
# STRIPE_DONATION_LINK is a HTTPS-only fallback for a manually managed Payment Link.
STRIPE_DONATION_LINK=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (email) — for newsletter welcome + transactional in v1.1
RESEND_API_KEY=""
RESEND_FROM="brad@mail.bbsports.fans"
BBSPORTS_APPROVED_RESEND="false"

# xAI Grok (AI drafting / counterpoint) — wired up in v1.1
XAI_API_KEY=""
BBSPORTS_APPROVED_XAI="false"
XAI_IMAGE_MODEL="grok-imagine-image"
XAI_VIDEO_MODEL="grok-imagine-video"

# Database (Neon / Railway Postgres) — wired up in v1.1
DATABASE_URL=""

# Auth (NextAuth or magic-link) — wired up in v1.1
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudflare R2 (object storage for images / podcast / video) — v1.1
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Approved provider gates (BB Sports Perfection Engine — Component 22)
BBSPORTS_APPROVED_LIVE_SCORES_FEED="false"
BBSPORTS_APPROVED_X_API="false"
BBSPORTS_APPROVED_YOUTUBE_TRANSCRIPT="false"

# Real-time newsroom. The manual verification desk remains available even when
# automated ingestion is disabled. Every external connector requires both its
# connector switch and its independent legal/commercial approval gate.
BBSPORTS_REALTIME_NEWSROOM_ENABLED="true"
BBSPORTS_NEWSROOM_X_ENABLED="false"
X_BEARER_TOKEN=""
BBSPORTS_NEWSROOM_XAI_ENABLED="false"
BBSPORTS_NEWSROOM_BLUESKY_ENABLED="false"
BBSPORTS_APPROVED_BLUESKY_JETSTREAM="false"
# Comma-separated did:plc identifiers for reviewed accounts; empty means ingest none.
BBSPORTS_BLUESKY_WANTED_DIDS=""
BBSPORTS_NEWSROOM_RSS_ENABLED="false"
BBSPORTS_APPROVED_NEWS_RSS="false"
