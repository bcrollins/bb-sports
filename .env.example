# BB Sports — environment variables
# Copy to .env.local for local development. Production values go in Railway → Variables.
# Never commit live secrets. Approval gates are exactly the string "true" when enabled.

# Public site URL (canonical, sitemap, OG, share URLs)
NEXT_PUBLIC_SITE_URL="https://bbsports.fans"

# Soft launch: set true only when Brad opens the wall and indexing is intended.
BBSPORTS_PUBLIC_LAUNCH="false"

# Site-wide access wall (soft launch). Railway only for live values.
# GATE_PASSWORD is the operator recovery credential when an admin wall password exists.
# Generate GATE_COOKIE_SECRET with: openssl rand -hex 32
GATE_PASSWORD=""
GATE_COOKIE_SECRET=""

# Admin auth (newsroom). JWT_SECRET min length enforced at runtime.
# ADMIN_EMAIL + ADMIN_PASSWORD_HASH are required in production and are upserted
# on every boot (Railway is recovery source of truth for Brad's login).
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
ADMIN_NAME="Brad Benson"

# Postgres (Railway / Neon)
DATABASE_URL=""

# Schema mode: bootstrap (default, IF NOT EXISTS DDL) | migrations (SQL ledger only)
# See docs/operations/MIGRATIONS.md
BBSPORTS_SCHEMA_MODE="bootstrap"

# First-party analytics digests (never reuse JWT_SECRET)
ANALYTICS_HASH_SALT=""

# Stripe donations — leave unset until end-to-end canary (docs/operations/COMMERCIAL-CANARIES.md)
# STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET → Checkout mode
# STRIPE_DONATION_LINK → HTTPS payment-link fallback only
STRIPE_DONATION_LINK=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BBSPORTS_APPROVED_STRIPE="false"

# Resend (newsletter welcome / transactional)
RESEND_API_KEY=""
RESEND_FROM="brad@mail.bbsports.fans"
BBSPORTS_APPROVED_RESEND="false"

# xAI Grok (AI draft/media assist — Brad-approved only)
XAI_API_KEY=""
BBSPORTS_APPROVED_XAI="false"
XAI_BASE_URL="https://api.x.ai/v1"
XAI_IMAGE_MODEL="grok-imagine-image"
XAI_VIDEO_MODEL="grok-imagine-video"

# Cloudflare R2 (object storage) — fail closed until approved
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
BBSPORTS_APPROVED_R2="false"

# Live scores / standings — NEVER enable without commercial license terms on file
# Runtime flag is BBSPORTS_APPROVED_LIVE_SCORES (not *_FEED)
BBSPORTS_APPROVED_LIVE_SCORES="false"
LIVE_SCORES_API_KEY=""
# Optional provider-specific aliases:
# SPORTRADAR_API_KEY=""
# SPORTSDATAIO_API_KEY=""

# Real-time newsroom. Manual verification desk works even when connectors are off.
# Every external connector needs its switch AND commercial approval gate.
BBSPORTS_REALTIME_NEWSROOM_ENABLED="true"
BBSPORTS_NEWSROOM_WORKER_ENABLED="false"
WORKER_HEALTH_PORT="3101"

BBSPORTS_NEWSROOM_X_ENABLED="false"
BBSPORTS_APPROVED_X_API="false"
X_BEARER_TOKEN=""

BBSPORTS_NEWSROOM_XAI_ENABLED="false"

BBSPORTS_NEWSROOM_BLUESKY_ENABLED="false"
BBSPORTS_APPROVED_BLUESKY_JETSTREAM="false"
# Comma-separated did:plc identifiers; empty means ingest none.
BBSPORTS_BLUESKY_WANTED_DIDS=""

BBSPORTS_NEWSROOM_RSS_ENABLED="false"
BBSPORTS_APPROVED_NEWS_RSS="false"

# Optional / future
BBSPORTS_APPROVED_YOUTUBE_TRANSCRIPT="false"
BBSPORTS_PODCAST_LIVE="false"
BBSPORTS_VIDEO_LIVE="false"
